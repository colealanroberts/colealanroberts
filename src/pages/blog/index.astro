---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getBlogPosts, formatDate } from '../../lib/blog';
import { withBase } from '../../lib/paths';
import '../../styles/blog.css';

const posts = (await getBlogPosts()).filter(({ data }) => !data.draft);
---
<BaseLayout title="Blog" description="Writing by Cole Roberts.">
  <main class="blog-page">
    <Breadcrumbs items={[{ label: 'Home', href: withBase() }, { label: 'Blog' }]} />
    <h1 class="page-title">Blog</h1>
    <div class="blog-introduction">
      <p class="blog-intro">A collection of writing</p>
      <p class="blog-subtitle">Mostly software engineering, sometimes life.</p>
    </div>
    {posts.length ? (
      <ul class="post-list">
        {posts.map(({ id, data }, index) => (
          <li>
            <article>
              <p class="post-meta"><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></p>
              <h2 class="post-title"><span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><a href={withBase(`blog/${id}/`)}>{data.title}</a></h2>
              <p class="post-description">{data.description}</p>
            </article>
          </li>
        ))}
      </ul>
    ) : <p class="blog-empty">Nothing here yet.</p>}
  </main>
</BaseLayout>

<style>
  .page-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
