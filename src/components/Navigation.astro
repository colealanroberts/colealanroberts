---
import { withBase } from '../lib/paths';
const blogPath = withBase('blog/');
const isBlog = Astro.url.pathname.replace(/\/$/, '') === blogPath.replace(/\/$/, '') || Astro.url.pathname.startsWith(blogPath);
---
<style>
.navigation {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0;
    margin: 32px 0 48px 0;
}

.navigation li {
    margin-bottom: 0;
    font-size: 0.75rem;
    line-height: 1.2;
}

.navigation ul {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 24px;
}

.navigation a {
    font-size: inherit;
    color: var(--foreground-muted);
    text-decoration: none;
}

.navigation a:hover,
.navigation a[aria-current] {
    color: var(--foreground);
}

.blog-link {
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

#wordmark {
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #6f6f6e;
}

</style>
<nav class="navigation" aria-label="Primary">
    <ul>
        <li>
            <a id="wordmark" href={withBase()}>Cole Roberts</a>
        </li>
        <li><a class="blog-link" href={blogPath} aria-current={isBlog ? 'true' : undefined}>Blog</a></li>
    </ul>
</nav>
