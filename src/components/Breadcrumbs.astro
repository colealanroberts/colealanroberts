---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, index) => (
      <li>
        {index > 0 && <span class="separator" aria-hidden="true">/</span>}
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page" title={item.label}>{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumbs { margin-bottom: 32px; color: #a1a39f; font-size: 0.625rem; line-height: 1.7; text-transform: uppercase; letter-spacing: 1.5px; }
  ol { display: flex; gap: 12px; list-style: none; padding: 0; margin: 0; white-space: nowrap; }
  li { display: flex; flex: 0 0 auto; gap: 12px; margin: 0; min-width: 0; }
  li:last-child { flex: 0 1 auto; }
  a { text-decoration: none; }
  [aria-current="page"] { min-width: 0; overflow: hidden; text-overflow: ellipsis; text-decoration: underline; text-underline-offset: 3px; }
  a:hover { color: var(--foreground); text-decoration: underline; text-underline-offset: 3px; }
  .separator { flex-shrink: 0; color: var(--foreground-muted); }
</style>
