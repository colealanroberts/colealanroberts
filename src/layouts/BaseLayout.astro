---
import Container from "../components/Container.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Head from "../components/Head.astro";
import Navigation from "../components/Navigation.astro";

const title = () => {
  return Astro.props.frontmatter?.title || Astro.props.title;
};

const { hideNavigation = false, hideBranding = false } = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <GoogleAnalytics />
        <Head title={ hideBranding ? title() : `${title()} · Cole Roberts` } description={Astro.props.description} />
    </head>
    <body>
        <Container>
            {!hideNavigation && <Navigation />}
                <slot />
        </Container>
    </body>
</html>
